# Pin matrix for MuxCore single-machine installer (laptop / first-run demo).
# Default spool tags: `default` + `media` — no acquisition/indexer/downloader modules.
# Modules without Forgejo Release binary assets fall back to MUXCORE_LAB_BIN
# (default: sibling ../_mvp/bin when present).

CORE_REPO=core
CORE_TAG=v0.5.0
CORE_ASSET_PREFIX=muxcored

# Essential host-stack modules (binary name = repo name unless noted).
# Format: repo=tag
# Release assets: https://git.zem.systems/muxcore/<repo>/releases/download/<tag>/
MODULES="
api-rest=v0.1.7
auth-local=v0.1.5
database-sqlite=v0.1.5
database-postgres=v0.1.2
secrets-file=v0.1.6
encryption-aesgcm=v0.2.6
call-policy-default=v0.3.3
publish-policy-default=v0.2.2
cache-local=v0.1.1
ratelimit-tokenbucket=v0.1.2
health-monitor=v0.1.5
metrics-prometheus=v0.1.1
tracing-otlp=v0.1.4
admin-ui=v0.1.10
metadata-tmdb=v0.1.5
media-movies=v0.1.9
media-tvshows=v0.1.9
media-automation=v0.1.8
media-scanner=v0.1.9
media-custom-formats=v0.1.6
media-rename=v0.2.6
media-ffprobe=v0.1.8
media-subtitles=v0.4.8
media-root-folders=v0.1.6
request-media=v0.2.7
notification-default=v0.1.6
jellyfin=v0.2.4
"

# Optional helper CLIs (often only available from laptop lab bins).
HELPER_BINS="authctl gettoken"

# Optional host profiles (see README): MUXCORE_PROFILE=sqlite|postgres
# postgres uses database-postgres (+ local Docker Postgres when DATABASE_URL unset).
# Set MUXCORE_OBSERVABILITY=1 to start metrics-prometheus + tracing-otlp (health-monitor is always on).
