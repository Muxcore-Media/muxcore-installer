# INSTALLER_TAG is the muxcore-setup release this pin matrix ships with.
# get-onboard.sh downloads the muxcore-setup binary for this tag.
INSTALLER_TAG="${INSTALLER_TAG:-v0.3.0}"

# Pin matrix for MuxCore single-machine installer.
# No acquisition, indexer, or downloader modules.

CORE_REPO=core
CORE_TAG=v0.5.0
CORE_ASSET_PREFIX=muxcored

# Format: repo=tag  (binary name = repo name unless install.sh maps it)
MODULES="
api-rest=v0.1.7
auth-local=v0.1.5
database-sqlite=v0.1.5
database-postgres=v0.1.2
secrets-file=v0.1.6
encryption-aesgcm=v0.2.6
call-policy-default=v0.3.3
publish-policy-default=v0.2.2
cache-local=v0.1.1
ratelimit-tokenbucket=v0.1.2
health-monitor=v0.1.5
metrics-prometheus=v0.1.1
tracing-otlp=v0.1.4
admin-ui=v0.1.10
metadata-tmdb=v0.1.5
metadata-musicbrainz=v0.1.0
media-movies=v0.1.9
media-tvshows=v0.1.9
media-music=v0.1.0
media-books=v0.1.0
media-comics=v0.1.0
media-audiobooks=v0.1.0
media-scanner=v0.1.9
